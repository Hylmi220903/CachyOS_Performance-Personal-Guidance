diff -urN a/drivers/cpuidle/governors/nap/Makefile b/drivers/cpuidle/governors/nap/Makefile
--- a/drivers/cpuidle/governors/nap/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/cpuidle/governors/nap/Makefile	2026-07-10 23:49:24.446737986 +0800
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Makefile for the NAP cpuidle governor (INT16 hybrid architecture)
+#
+# Inference (nap.o, nap_int.o): compiled with NORMAL kernel flags (no FPU).
+# Training  (nap_train.o, nap_nn_*.o): compiled with FPU/SIMD flags.
+#
+# This separation guarantees the compiler cannot emit SSE/AVX instructions
+# in governor hotpath callbacks (nap_select, nap_reflect), which would
+# corrupt userspace FPU register state.  Training runs in workqueue context
+# where kernel_fpu_begin/end is safe.
+#
+
+obj-$(CONFIG_CPU_IDLE_GOV_NAP) += cpuidle_gov_nap.o
+
+cpuidle_gov_nap-y := nap.o nap_int.o nap_train.o nap_nn_sse2.o nap_nn_avx2.o
+
+# Remove kernel's default FPU-kill flags for training files only
+FPU_KILL_FLAGS := -mno-sse -mno-sse2 -mno-mmx -mno-avx -mno-3dnow \
+                  -mno-sse4a -msoft-float -mno-80387 -mno-fp-ret-in-387
+
+CFLAGS_REMOVE_nap_train.o      += $(FPU_KILL_FLAGS)
+CFLAGS_REMOVE_nap_nn_sse2.o    += $(FPU_KILL_FLAGS)
+CFLAGS_REMOVE_nap_nn_avx2.o    += $(FPU_KILL_FLAGS)
+
+CFLAGS_nap_train.o     += $(CC_FLAGS_FPU)
+CFLAGS_nap_nn_sse2.o   += $(CC_FLAGS_FPU)
+CFLAGS_nap_nn_avx2.o   += $(CC_FLAGS_FPU) -mavx -mavx2 -mfma
diff -urN a/drivers/cpuidle/governors/nap/nap.c b/drivers/cpuidle/governors/nap/nap.c
--- a/drivers/cpuidle/governors/nap/nap.c	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/cpuidle/governors/nap/nap.c	2026-07-11 00:19:02.492481300 +0800
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * nap.c - Neural Adaptive Predictor cpuidle governor (Integer Hybrid)
+ *
+ * This file is compiled WITHOUT FPU/SSE flags.
+ */
+
+#include <linux/cpuidle.h>
+#include <linux/cpu.h>
+#include <linux/jiffies.h>
+#include <linux/percpu.h>
+#include <linux/sched/clock.h>
+#include <linux/tick.h>
+#include <linux/math64.h>
+#include <linux/bitops.h>
+#include <linux/workqueue.h>
+#include "nap.h"
+
+DEFINE_STATIC_KEY_FALSE(nap_use_avx2);
+
+static void __init nap_detect_simd(void)
+{
+	if (boot_cpu_has(X86_FEATURE_FMA) && boot_cpu_has(X86_FEATURE_AVX2)) {
+		static_branch_enable(&nap_use_avx2);
+		pr_info("nap: using AVX2+FMA\n");
+	} else {
+		pr_info("nap: using SSE2\n");
+	}
+}
+
+DEFINE_PER_CPU(struct nap_cpu_data, nap_data);
+struct cpuidle_driver *nap_cached_drv;
+
+static void nap_history_update(struct nap_cpu_data *d, u64 measured_ns)
+{
+	d->history[d->hist_idx] = measured_ns;
+	d->hist_idx = (d->hist_idx + 1) % NAP_HISTORY_SIZE;
+	if (d->hist_count < NAP_HISTORY_SIZE)
+		d->hist_count++;
+}
+
+static inline int nap_get_min_valid_state(struct nap_cpu_data *d,
+					  struct cpuidle_driver *drv,
+					  struct cpuidle_device *dev,
+					  s64 latency_req)
+{
+	if (unlikely(latency_req != d->cached_min_state_latency ||
+		     time_after(jiffies, d->cached_min_state_jiffies + NAP_MIN_STATE_REFRESH_JIFFIES))) {
+		int i;
+		d->cached_min_state = 0;
+		for (i = 1; i < drv->state_count; i++) {
+			if (dev->states_usage[i].disable) continue;
+			if (drv->states[i].exit_latency_ns > latency_req) continue;
+			d->cached_min_state = i;
+			break;
+		}
+		d->cached_min_state_latency = latency_req;
+		d->cached_min_state_jiffies = jiffies;
+	}
+	return d->cached_min_state;
+}
+
+static int nap_select(struct cpuidle_driver *drv, struct cpuidle_device *dev, bool *stop_tick)
+{
+	struct nap_cpu_data *d = this_cpu_ptr(&nap_data);
+	s64 latency_req = cpuidle_governor_latency_req(dev->cpu);
+	ktime_t delta_tick;
+	u64 sleep_length_ns = ktime_to_ns(tick_nohz_get_sleep_length(&delta_tick));
+	int min_state = nap_get_min_valid_state(d, drv, dev, latency_req);
+	int idx;
+
+	if (unlikely(drv->state_count <= 1)) return 0;
+
+	if (min_state == 0 || sleep_length_ns < drv->states[min_state].target_residency_ns) {
+		dev->poll_limit_ns = max_t(u64, sleep_length_ns, NAP_POLL_LIMIT_MIN_NS);
+		*stop_tick = false;
+		d->last_selected_idx = 0;
+		d->short_circuited = true;
+		d->stats.total_selects++;
+		return 0;
+	}
+	d->short_circuited = false;
+
+	if (hweight8(d->intercept_bits) >= NAP_INTERCEPT_THRESHOLD) {
+		idx = min_state;
+	} else {
+		idx = nap_int_select(drv, dev, d);
+		if (idx == 0) idx = min_state;
+	}
+
+	*stop_tick = (drv->states[idx].target_residency_ns > RESIDENCY_THRESHOLD_NS);
+	d->last_selected_idx = idx;
+	d->stats.total_selects++;
+	return idx;
+}
+
+static void nap_reflect(struct cpuidle_device *dev, int index)
+{
+	struct nap_cpu_data *d = this_cpu_ptr(&nap_data);
+	struct cpuidle_driver *drv = cpuidle_get_cpu_driver(dev);
+	u64 measured_ns = dev->last_residency_ns;
+
+	if (unlikely(!drv)) return;
+	if (d->short_circuited) {
+		d->stats.total_residency_ns += measured_ns;
+		return;
+	}
+
+	nap_history_update(d, measured_ns);
+	d->last_prediction_error = d->last_predicted_ns - (s64)measured_ns;
+	d->prev_idle_exit = local_clock();
+	
+	d->intercept_bits <<= 1;
+	if (measured_ns < d->last_predicted_ns / 2)
+		d->intercept_bits |= 1;
+
+	nap_int_update_histogram(d, drv, measured_ns);
+
+	d->learn_actual_ns = measured_ns;
+	d->have_sample = true;
+
+	if (++d->learn_counter >= d->learn_interval &&
+	    time_after_eq(jiffies, d->last_learn_jiffies + d->learn_jiffies_min)) {
+		d->learn_counter = 0;
+		d->last_learn_jiffies = jiffies;
+		d->needs_learn = true;
+		schedule_work_on(d->learn_cpu, &d->learn_work);
+	}
+
+	d->stats.total_residency_ns += measured_ns;
+	if (index > 0 && measured_ns < drv->states[index].target_residency_ns)
+		d->stats.overshoot_count++;
+}
+
+static int nap_enable(struct cpuidle_driver *drv, struct cpuidle_device *dev)
+{
+	struct nap_cpu_data *d = per_cpu_ptr(&nap_data, dev->cpu);
+	memset(d, 0, sizeof(*d));
+	WRITE_ONCE(nap_cached_drv, drv);
+	d->learning_rate_millths = NAP_DEFAULT_LR_MILLTHS;
+	d->learn_interval = NAP_DEFAULT_INTERVAL;
+	d->max_grad_norm_millths = NAP_DEFAULT_CLAMP_MILLTHS;
+	d->conf_millths = NAP_DEFAULT_CONF_MILLTHS;
+	d->conf_q10 = (NAP_DEFAULT_CONF_MILLTHS * 1024) / 1000;
+	d->cached_min_state_latency = S64_MIN;
+	d->cached_min_state_jiffies = jiffies - NAP_MIN_STATE_REFRESH_JIFFIES;
+	d->learn_jiffies_min = NAP_TRAIN_MIN_JIFFIES;
+	d->reset_pending = true;
+	d->learn_cpu = dev->cpu;
+	INIT_WORK(&d->learn_work, nap_train_work_fn);
+	return 0;
+}
+
+static void nap_disable(struct cpuidle_driver *drv, struct cpuidle_device *dev)
+{
+	struct nap_cpu_data *d = per_cpu_ptr(&nap_data, dev->cpu);
+	cancel_work_sync(&d->learn_work);
+	WRITE_ONCE(nap_cached_drv, NULL);
+}
+
+static struct cpuidle_governor nap_governor = {
+	.name    = "nap",
+	.rating  = 26,
+	.enable  = nap_enable,
+	.disable = nap_disable,
+	.select  = nap_select,
+	.reflect = nap_reflect,
+};
+
+static int __init nap_init(void)
+{
+	nap_detect_simd();
+	return cpuidle_register_governor(&nap_governor);
+}
+postcore_initcall(nap_init);
diff -urN a/drivers/cpuidle/governors/nap/nap.h b/drivers/cpuidle/governors/nap/nap.h
--- a/drivers/cpuidle/governors/nap/nap.h	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/cpuidle/governors/nap/nap.h	2026-07-11 00:19:14.039836488 +0800
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef NAP_H
+#define NAP_H
+
+#include <linux/cpuidle.h>
+#include <linux/jump_label.h>
+#include <linux/ktime.h>
+#include <linux/workqueue.h>
+
+/* ================================================================
+ * Version
+ * ================================================================ */
+
+#define CPUIDLE_NAP_VERSION  "0.6.0-int16"
+
+/* ================================================================
+ * Neural network dimensions
+ * ================================================================ */
+
+#define NAP_INPUT_SIZE    8
+#define NAP_HIDDEN_SIZE   8
+#define NAP_NUM_CUTS      (CPUIDLE_STATE_MAX - 1)
+
+/* ================================================================
+ * Fixed-point arithmetic
+ *
+ * Q8.8: int16_t, 1 unit = 1/256.  Range [-128, +127.996].
+ * Used for weight storage and feature representation.
+ *
+ * Accumulation in int32_t avoids overflow during matmul:
+ *   worst case: 8 terms × (128*256)^2 / 256 = 8 × 32768^2 / 256
+ *   = 8 × 1073741824 / 256 = 33554432, well within int32_t.
+ *
+ * Q0.10: Survival probability [0, 1024] maps to [0.0, 1.0].
+ * ================================================================ */
+
+#define NAP_Q8_SHIFT      8
+#define NAP_Q8_SCALE      256       /* 1 << 8 */
+#define NAP_Q8_ONE        256       /* 1.0 in Q8.8 */
+
+#define NAP_Q10_SHIFT     10
+#define NAP_Q10_SCALE     1024      /* 1 << 10 */
+
+/* Convert float to Q8.8 (for compile-time constants) */
+#define NAP_FLOAT_TO_Q8(f)  ((int16_t)((f) * NAP_Q8_SCALE))
+
+/* ================================================================
+ * Tunables
+ * ================================================================ */
+
+#define NAP_HISTORY_SIZE              8
+#define NAP_FLOOR_WIN                 256
+#define NAP_FLOOR_DECAY_NUM           255   /* 255/256 per idle */
+#define NAP_PRIOR_K                   16
+#define NAP_PRIOR_K_Q8               (NAP_PRIOR_K * NAP_Q8_SCALE)
+
+#define NAP_MIN_STATE_REFRESH_JIFFIES HZ
+#define NAP_POLL_LIMIT_MIN_NS         1000ULL
+#define NAP_POLL_LIMIT_MARGIN_NS      1000ULL
+#define RESIDENCY_THRESHOLD_NS        15000ULL
+
+/* Intercept detection: if >= this many of last 8 idles were intercepts */
+#define NAP_INTERCEPT_THRESHOLD       4
+
+/* Governor defaults */
+#define NAP_DEFAULT_LR_MILLTHS        1     /* 0.001 */
+#define NAP_DEFAULT_INTERVAL          4
+#define NAP_DEFAULT_CLAMP_MILLTHS     1000  /* 1.0 */
+#define NAP_DEFAULT_CONF_MILLTHS      500   /* 0.5 */
+
+/* Training throttle: minimum jiffies between workqueue dispatches */
+#define NAP_TRAIN_MIN_JIFFIES         HZ    /* 1 second */
+
+/* ================================================================
+ * Sigmoid lookup table (Q0.10 output)
+ *
+ * 256 entries covering input range [-8.0, +8.0] in Q8.8.
+ * Index = clamp((x_q8 + 2048) >> 4, 0, 255)
+ * where x_q8 is the Q8.8 input (s - threshold).
+ *
+ * Generated by: lut[i] = round(1024 / (1 + exp(-(i*16.0/256.0 - 8.0))))
+ * ================================================================ */
+
+#define NAP_SIGMOID_LUT_SIZE   256
+#define NAP_SIGMOID_LUT_SHIFT  4     /* input >> 4 to get index */
+#define NAP_SIGMOID_LUT_OFFSET 2048  /* offset to make input non-negative */
+
+extern const u16 nap_sigmoid_lut[NAP_SIGMOID_LUT_SIZE];
+
+/* ================================================================
+ * Weight structures
+ * ================================================================ */
+
+/*
+ * Quantized weights for integer inference (hotpath, no FPU).
+ * All values in Q8.8 fixed-point.
+ */
+struct nap_weights_q8 {
+	int16_t w_h1[NAP_INPUT_SIZE][NAP_HIDDEN_SIZE];
+	int16_t b_h1[NAP_HIDDEN_SIZE];
+	int16_t w_out[NAP_HIDDEN_SIZE];
+	int16_t b_out;
+	int16_t thr_ord[NAP_NUM_CUTS];
+};
+
+/*
+ * Float weights for training (workqueue context, FPU required).
+ * Column-major: w_h1[j][i] = weight from input j to hidden neuron i.
+ * __aligned(32) for AVX2 vmovaps.
+ */
+struct nap_weights {
+	float w_h1[NAP_INPUT_SIZE][NAP_HIDDEN_SIZE];
+	float b_h1[NAP_HIDDEN_SIZE];
+	float w_out[NAP_HIDDEN_SIZE];
+	float b_out;
+	float thr_ord[NAP_NUM_CUTS];
+} __aligned(32);
+
+/* ================================================================
+ * Statistics
+ * ================================================================ */
+
+struct nap_stats {
+	u64 total_selects;
+	u64 total_residency_ns;
+	u64 overshoot_count;
+	u64 learn_count;
+};
+
+/* ================================================================
+ * Per-CPU data
+ * ================================================================ */
+
+struct nap_cpu_data {
+	/* --- Hotpath (pure integer, no FPU) --- */
+
+	/* Raw residency ring buffer */
+	u64   history[NAP_HISTORY_SIZE];
+	int   hist_idx;
+	int   hist_count;
+
+	/* Log2 history ring buffer (Q8.8) */
+	int32_t log_history_q8[NAP_HISTORY_SIZE];
+
+	/*
+	 * Intercept detection bitmask: last 8 idles.
+	 * Bit set = residency was < sleep_length / 2 (intercept).
+	 * popcount >= NAP_INTERCEPT_THRESHOLD → bypass NN, return shallow.
+	 */
+	u8 intercept_bits;
+
+	/* External signal tracking */
+	u64   prev_idle_exit;
+	s64   last_predicted_ns;
+	s64   last_prediction_error;
+
+	/* POLL short-circuit */
+	bool  short_circuited;
+	int   cached_min_state;
+	s64   cached_min_state_latency;
+	unsigned long cached_min_state_jiffies;
+
+	/* Select/reflect handoff */
+	int   last_selected_idx;
+
+	/* Integer NN scratch (populated by nap_int_select) */
+	int32_t nn_output_q8;
+	int32_t hidden_out_q8[NAP_HIDDEN_SIZE];
+	int32_t features_q8[NAP_INPUT_SIZE];
+
+	/* Quantized weights (read by hotpath integer inference) */
+	struct nap_weights_q8 w_q8;
+
+	/* Decayed histogram floor (Q8.8 fixed-point counts) */
+	int32_t bin_count_q8[CPUIDLE_STATE_MAX];
+
+	/* log2(target_residency_ns) per state (Q8.8) */
+	int32_t log2_tres_q8[CPUIDLE_STATE_MAX];
+
+	/* Confidence level (Q0.10, range [1, 1023]) */
+	int32_t conf_q10;
+
+	/* --- Training (workqueue context, uses FPU) --- */
+	struct work_struct learn_work;
+	int    learn_cpu;		/* CPU this data belongs to */
+
+	/* Float weights (master copy, trained in workqueue) */
+	struct nap_weights weights_float;
+
+	/* Backprop scratch (workqueue only, needs FPU flags) */
+	float  learn_d_out;
+	float  learn_lr;
+	float  learn_d_hid[NAP_HIDDEN_SIZE] __aligned(32);
+	float  hidden_out_f[NAP_HIDDEN_SIZE] __aligned(32);
+	float  features_f32[NAP_INPUT_SIZE] __aligned(32);
+	struct nap_weights *active_w;
+
+	/* Training sample handoff (reflect → workqueue) */
+	u64    learn_actual_ns;
+	bool   have_sample;
+	bool   needs_learn;
+	int    learn_counter;
+	int    learn_interval;
+	unsigned long last_learn_jiffies;
+	unsigned int  learn_jiffies_min;
+
+	/* Hyperparameters */
+	unsigned int learning_rate_millths;
+	unsigned int max_grad_norm_millths;
+	unsigned int conf_millths;
+
+	/* State management */
+	bool   reset_pending;
+
+	/* Statistics */
+	struct nap_stats stats;
+};
+
+DECLARE_PER_CPU(struct nap_cpu_data, nap_data);
+
+/* ISA dispatch static key (defined in nap.c) */
+DECLARE_STATIC_KEY_FALSE(nap_use_avx2);
+extern struct cpuidle_driver *nap_cached_drv;
+
+/* ================================================================
+ * Function declarations
+ * ================================================================ */
+
+/* Integer inference (nap_int.c) — no FPU, safe in idle hotpath */
+int nap_int_select(struct cpuidle_driver *drv,
+		   struct cpuidle_device *dev,
+		   struct nap_cpu_data *d);
+
+void nap_int_update_histogram(struct nap_cpu_data *d,
+			      struct cpuidle_driver *drv,
+			      u64 measured_ns);
+
+void nap_int_init_thresholds(struct nap_cpu_data *d,
+			     struct cpuidle_driver *drv);
+
+/* Training (nap_train.c) — FPU required, call from workqueue only */
+void nap_train_init(struct nap_cpu_data *d, struct cpuidle_driver *drv);
+void nap_train_work_fn(struct work_struct *work);
+
+/* Quantize float weights to Q8.8 integer */
+void nap_quantize_weights(const struct nap_weights *src,
+			  struct nap_weights_q8 *dst);
+
+/* SIMD forward/backward (nap_nn_*.c) — FPU required */
+void nap_nn_forward_sse2(const float *input, float *output,
+			 float *hidden_save, const struct nap_weights *w);
+void nap_nn_forward_avx2(const float *input, float *output,
+			 float *hidden_save, const struct nap_weights *w);
+void nap_nn_learn_sse2(struct nap_cpu_data *d);
+void nap_nn_learn_avx2(struct nap_cpu_data *d);
+
+/* sysfs */
+int  nap_sysfs_init(void);
+void nap_sysfs_exit(void);
+
+/* ================================================================
+ * SIMD type definitions (only for FPU-compiled files)
+ * ================================================================ */
+
+#ifdef __SSE2__
+
+typedef float v4sf  __attribute__((__vector_size__(16)));
+typedef int   v4si  __attribute__((__vector_size__(16)));
+typedef float v8sf  __attribute__((__vector_size__(32)));
+
+#define V4SF_SET1(x)  ((v4sf){ (x), (x), (x), (x) })
+#define V4SI_SET1(x)  ((v4si){ (x), (x), (x), (x) })
+#define V8SF_SET1(x)  ((v8sf){ (x),(x),(x),(x),(x),(x),(x),(x) })
+#define V8SF_ZERO     V8SF_SET1(0.0f)
+
+static inline v4sf v4sf_clamp(v4sf v, v4sf lo, v4sf hi)
+{
+	return __builtin_ia32_maxps(__builtin_ia32_minps(v, hi), lo);
+}
+
+static inline v4si v4sf_as_v4si(v4sf v)
+{
+	union { v4sf f; v4si i; } u = { .f = v };
+	return u.i;
+}
+
+static inline v4sf v4si_as_v4sf(v4si v)
+{
+	union { v4si i; v4sf f; } u = { .i = v };
+	return u.f;
+}
+
+static inline float fclampf(float v, float lo, float hi)
+{
+	if (v < lo) return lo;
+	if (v > hi) return hi;
+	return v;
+}
+
+#endif /* __SSE2__ */
+
+#endif /* NAP_H */
